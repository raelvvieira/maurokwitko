{
  // Cloudflare Workers (static assets) — serves the Vite build in ./dist as an SPA.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maurokwitko",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
